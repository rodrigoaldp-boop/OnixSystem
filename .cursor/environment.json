{
  "name": "Onix System",
  "install": "bash scripts/cloud-agent-install.sh",
  "start": "bash scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd /workspace && source .venv/bin/activate && python -m uvicorn sga_financeiro.main:app --host 0.0.0.0 --port 8000",
      "description": "Onix System FastAPI server (web UI + API) on http://localhost:8000"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 8000
    }
  ]
}
